# Ambiente de desenvolvimento (carregado por `config.settings.local` via `manage.py`).
# Coloque aqui overrides; o arquivo `.env` (se existir) é carregado antes e este arquivo sobrescreve.

DEBUG=True

# Hosts Django (dev). Inclua host.docker.internal se usar webhook Evolution no container.
# ALLOWED_HOSTS=localhost,127.0.0.1,app.localhost,host.docker.internal

# CORS (front Vite em outra porta). Com CORS_ALLOW_ALL_ORIGINS=True a lista abaixo é ignorada.
# Para espelhar produção: CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://app.localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Reset de senha no subdomínio do app (produção: https://app.marketchat.com.br/reset-password)
FRONTEND_PASSWORD_RESET_URL=http://app.localhost:5173/reset-password

ASAAS_WEBHOOK_VERIFY=False
# ASAAS_WEBHOOK_TOKEN pode ficar vazio em dev quando a verificação está desligada.

# Asaas (cadastro trial / cartão). Obrigatório para POST /api/auth/register/.
# Chave em Integrações → Chaves de API. Sandbox: prefixo $aact_hmlg_ (o $ faz parte da chave).
# Se você usa .env + .env.development: a chave precisa existir (com valor) em pelo menos um dos dois;
# se .env tiver ASAAS_API_KEY= vazio e .env.development não repetir a variável, o Django fica com chave vazia.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# CPF válido para criar cliente do morador no Asaas sandbox (cobrança Pix WhatsApp).
ASAAS_RESIDENT_DEFAULT_CPF=11144477735
# Taxa da plataforma sobre vendas Pix creditadas na carteira virtual (%).
FINANCIAL_PLATFORM_FEE_PERCENT=2

# E-mail (SMTP). Use o backend abaixo se EMAIL_HOST for CNAME e o certificado for de outro host (Mailhostbox, etc.).
EMAIL_BACKEND=config.email_backend.EmailBackend
EMAIL_HOST=smtp.marketchat.com.br
EMAIL_SMTP_TLS_SERVERNAME=us2.smtp.mailhostbox.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Evolution GO (WhatsApp). Container na porta 8080; Django em dev na 8001 (scripts/dev.sh).
# ALLOWED_HOSTS deve incluir host.docker.internal (webhook vindo do container).
# ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
# EVOLUTION_GLOBAL_API_KEY = mesma chave do container (evoapicloud: GLOBAL_API_KEY; imagem oficial: AUTHENTICATION_API_KEY).
# PUBLIC_WEBHOOK_BASE_URL deve ser alcançável de DENTRO do container (Linux: extra_hosts host.docker.internal).
EVOLUTION_API_BASE_URL=http://127.0.0.1:8080
EVOLUTION_GLOBAL_API_KEY=
PUBLIC_WEBHOOK_BASE_URL=http://host.docker.internal:8001
EVOLUTION_WEBHOOK_EVENTS=MESSAGE,CONNECTION,QRCODE
WEBHOOK_SHARED_SECRET=

# IA — classificação de intenção nos fluxos do chatbot (servidor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
