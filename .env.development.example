# Ambiente de desenvolvimento (carregado por `config.settings.local` via `manage.py`).
# Coloque aqui overrides; o arquivo `.env` (se existir) é carregado antes e este arquivo sobrescreve.

DEBUG=True

# CORS (front Vite em outra porta). Com CORS_ALLOW_ALL_ORIGINS=True a lista abaixo é ignorada.
# Para espelhar produção: CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

ASAAS_WEBHOOK_VERIFY=False
# ASAAS_WEBHOOK_TOKEN pode ficar vazio em dev quando a verificação está desligada.

# Asaas (cadastro trial / cartão). Obrigatório para POST /api/auth/register/.
# Chave em Integrações → Chaves de API. Sandbox: prefixo $aact_hmlg_ (o $ faz parte da chave).
# Se você usa .env + .env.development: a chave precisa existir (com valor) em pelo menos um dos dois;
# se .env tiver ASAAS_API_KEY= vazio e .env.development não repetir a variável, o Django fica com chave vazia.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=

# E-mail (SMTP). Use o backend abaixo se EMAIL_HOST for CNAME e o certificado for de outro host (Mailhostbox, etc.).
EMAIL_BACKEND=config.email_backend.EmailBackend
EMAIL_HOST=smtp.marketchat.com.br
EMAIL_SMTP_TLS_SERVERNAME=us2.smtp.mailhostbox.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password
