# Copie para .env.staging e preencha os valores reais (não commite .env.staging).

SECRET_KEY=altere-para-um-valor-aleatorio-longo

DEBUG=False
ALLOWED_HOSTS=staging.marketchat.com.br,staging-app.marketchat.com.br,staging-api.marketchat.com.br,192.168.1.23,localhost,127.0.0.1

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://staging.marketchat.com.br,https://staging-app.marketchat.com.br
CSRF_TRUSTED_ORIGINS=https://staging.marketchat.com.br,https://staging-app.marketchat.com.br

# Porta da API no host (container interno continua 8000). 8001 evita conflito com Portainer.
STAGING_BACKEND_PORT=8001

# Postgres no host (container postgres-db, porta 5432)
DATABASE_URL=postgres://postgres:postgres@192.168.1.23:5432/postgres

# Evolution GO no host (container evolution_go, porta 8080)
EVOLUTION_API_BASE_URL=http://192.168.1.23:8080
# Chave admin do Evolution GO (Portainer: variável GLOBAL_API_KEY ou AUTHENTICATION_API_KEY)
EVOLUTION_GLOBAL_API_KEY=defina_a_chave_do_portainer

# URL pública do backend (webhooks Asaas / Evolution)
# Mesmo host do app; Apache encaminha /api para Django (:8001)
PUBLIC_WEBHOOK_BASE_URL=https://staging-app.marketchat.com.br

# Build do front (docker compose build args)
VITE_API_BASE_URL=https://staging-api.marketchat.com.br
VITE_APP_ORIGIN=https://staging-app.marketchat.com.br
VITE_MARKETING_ORIGIN=https://staging.marketchat.com.br
VITE_PLAN_PRICE=59,90
VITE_TRIAL_SUBSCRIPTION_PRICE=59,90

TRANSACTIONAL_FROM_EMAIL=MarketChat <suporte@marketchat.com.br>
MARKETING_PUBLIC_ORIGIN=https://staging.marketchat.com.br
FRONTEND_APP_ORIGIN=https://staging-app.marketchat.com.br
FRONTEND_SIGNIN_URL=https://staging-app.marketchat.com.br/signin
FRONTEND_PASSWORD_RESET_URL=https://staging-app.marketchat.com.br/reset-password

# Integrações (preencher conforme homologação)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_WITHDRAWAL_TOKEN=
OPENAI_API_KEY=
