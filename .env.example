# Exemplo de variáveis compartilhadas (opcional).
# Desenvolvimento: copie também `.env.development.example` -> `.env.development`
# (carregado automaticamente com `manage.py` + `config.settings.local`).
# Produção: use `.env.production.example` -> `.env.production` com DJANGO_SETTINGS_MODULE=config.settings.production

# Django
SECRET_KEY=altere-para-uma-chave-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (exemplo): postgres://usuario:senha@localhost:5432/marketchat

# CORS (front em outra origem: Vite costuma ser 5173; CRA/Next costumam ser 3000)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost:3000

# E-mail (recuperação de senha)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Alternativa (CNAME smtp.seudominio + cert no host do provedor): config.email_backend.EmailBackend
# + EMAIL_SMTP_TLS_SERVERNAME=us2.smtp.mailhostbox.com
EMAIL_HOST=smtp.exemplo.com
EMAIL_SMTP_TLS_SERVERNAME=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@suaempresa.com
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Asaas
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=sua_chave_api
ASAAS_WEBHOOK_TOKEN=token_secreto_para_validar_webhooks
# Em produção use ASAAS_WEBHOOK_VERIFY=True (padrão no código se omitido).
ASAAS_WEBHOOK_VERIFY=True

# Assinatura / trial
TRIAL_DAYS=7
DEFAULT_SUBSCRIPTION_VALUE=29.9
