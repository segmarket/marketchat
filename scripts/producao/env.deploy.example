# Copie para env.deploy (não versionado): cp env.deploy.example env.deploy
# Carregado automaticamente por remote-lib.sh

# SSH (recomendado: chave em ~/.ssh/config, sem senha no arquivo)
PRODUCTION_SSH=seguser@10.10.10.140
PRODUCTION_PATH=marketchat
PRODUCTION_SERVER_IP=10.10.10.140

# Opcional: só se usar autenticação por senha (instale sshpass: sudo dnf install sshpass)
# NUNCA commite env.deploy com senha no Git.
# DEPLOY_SSH_PASSWORD=

# Enviar .env.production do notebook para o servidor (1 na primeira vez, 0 depois)
PUSH_LOCAL_ENV=0
