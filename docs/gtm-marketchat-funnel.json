  "signupFunnel": {
    "url": "/auth/signup",
    "steps": [
      {
        "step": 1,
        "name": "Contato (F1)",
        "uiFields": ["fullName", "phone", "email", "password", "acceptTerms"],
        "onContinue": {
          "dataLayer": {
            "event": "lead_generated",
            "note": "Dispara ANTES do POST de lead; falha de API não bloqueia avanço"
          },
          "api": {
            "method": "POST",
            "endpoint": "/api/auth/signup-lead/",
            "auth": "AllowAny",
            "payload": {
              "lead_type": "F1",
              "full_name": "string — nome completo",
              "email": "string — e-mail",
              "phone": "string — só dígitos (DDD + número)"
            },
            "response201": {
              "id": "number",
              "status": "NOVO",
              "lead_type": "F1"
            },
            "crmEffect": "Upsert Lead por e-mail; lead_type=F1; status=Novo"
          },
          "metaPixel": "Lead",
          "ga4": "generate_lead"
        }
      },
      {
        "step": 2,
        "name": "Empresa (F2)",
        "uiFields": [
          "company_name",
          "cpfCnpj",
          "cep",
          "address",
          "addressNumber",
          "complement",
          "province"
        ],
        "onContinue": {
          "dataLayer": null,
          "api": {
            "method": "POST",
            "endpoint": "/api/auth/signup-lead/",
            "auth": "AllowAny",
            "payload": {
              "lead_type": "F2",
              "email": "string — mesmo e-mail do passo 1",
              "company_name": "string",
              "address": "string — logradouro e cidade (ViaCEP concatena)",
              "address_number": "string",
              "complement": "string — opcional",
              "cep": "string — 8 dígitos",
              "state": "string — UF (province, ex: SP)"
            },
            "response201": {
              "id": "number",
              "status": "NOVO | EM_CONTATO | ...",
              "lead_type": "F2"
            },
            "crmEffect": "Atualiza Lead existente; lead_type=F2; preenche company_name, company_address, state"
          },
          "metaPixel": null,
          "ga4": null,
          "note": "Sem evento dataLayer neste passo — intenção F2 fica só no CRM Django Admin"
        }
      },
      {
        "step": 3,
        "name": "Cartão de crédito + trial",
        "uiFields": ["cardNumber", "cardName", "cardExpiry", "cardCvv"],
        "onMount": {
          "dataLayer": {
            "event": "initiate_checkout",
            "includes": ["ecommerce", "user_data (hashes SHA-256)"]
          },
          "metaPixel": "InitiateCheckout",
          "ga4": "begin_checkout + ecommerce"
        },
        "onSubmitClick": {
          "order": [
            "1. dataLayer add_payment_info",
            "2. POST /api/auth/register/",
            "3. dataLayer sign_up (se OK)",
            "4. dataLayer start_trial (se OK)"
          ],
          "dataLayerBeforePost": {
            "event": "add_payment_info",
            "includes": ["ecommerce", "user_data (hashes SHA-256)"]
          },
          "api": {
            "method": "POST",
            "endpoint": "/api/auth/register/",
            "auth": "AllowAny",
            "payload": {
              "company_name": "string",
              "tenant_slug": "string — slugify(company_name)",
              "admin_email": "string",
              "admin_password": "string",
              "first_name": "string",
              "last_name": "string",
              "accept_terms": true,
              "attribution": {
                "utm_source": "opcional",
                "utm_medium": "opcional",
                "utm_campaign": "opcional",
                "utm_term": "opcional",
                "utm_content": "opcional",
                "gclid": "opcional",
                "fbclid": "opcional"
              },
              "credit_card": {
                "holderName": "string — nome no cartão",
                "number": "string — só dígitos",
                "expiryMonth": "string — MM",
                "expiryYear": "string — YYYY",
                "ccv": "string — 3 ou 4 dígitos"
              },
              "credit_card_holder": {
                "name": "string — nome completo",
                "email": "string",
                "cpfCnpj": "string — só dígitos",
                "postalCode": "string — CEP só dígitos",
                "address": "string",
                "addressNumber": "string",
                "complement": "string — opcional",
                "province": "string — UF",
                "phone": "string — só dígitos"
              }
            },
            "response201": {
              "id": "user id",
              "email": "string",
              "tenant_id": "number"
            },
            "serverSideEffects": [
              "create_trial_subscription (Asaas tokenização + assinatura)",
              "Facebook CAPI StartTrial (event_id: start_trial_tenant_{tenant_id})",
              "mark_lead_converted → Lead.status=CONVERTIDO"
            ]
          },
          "dataLayerAfterSuccess": [
            {
              "event": "sign_up",
              "payload": { "method": "email" },
              "metaPixel": "CompleteRegistration (opcional — ligar tag ao trigger sign_up)",
              "ga4": "sign_up"
            },
            {
              "event": "start_trial",
              "payload": {
                "currency": "BRL",
                "value": 59.9,
                "hashed_email": "sha256 hex lowercase",
                "hashed_phone": "sha256 hex com prefixo 55 se BR"
              },
              "metaPixel": "StartTrial",
              "ga4": "start_trial (custom)",
              "guardrail": "ÚNICO gatilho browser para StartTrial — só após register OK"
            }
          ],
          "metaPixel": "AddPaymentInfo (no clique, antes do POST)",
          "ga4": "add_payment_info + ecommerce"
        }
      }
    ]
  },
