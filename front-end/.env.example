# Origens do front multi-domínio (dev: adicione app.localhost no /etc/hosts -> 127.0.0.1)
VITE_APP_ORIGIN=http://app.localhost:5173
VITE_MARKETING_ORIGIN=http://localhost:5173

# Porta do Django em dev (proxy do Vite e runserver). 8001 evita conflito com Portainer (8000).
VITE_DEV_API_PORT=8001

# URL base da API Django (sem path /api). Em `npm run dev`, pode ficar vazio: o Vite
# faz proxy de /api -> http://127.0.0.1:${VITE_DEV_API_PORT} (veja vite.config.ts).
# Em build de produção, defina sempre (ex.: https://api.seudominio.com).
VITE_API_BASE_URL=http://127.0.0.1:8001

# Valor exibido no resumo do trial (alinhado ao DEFAULT_SUBSCRIPTION_VALUE do Django, ex.: 29.9)
VITE_TRIAL_SUBSCRIPTION_PRICE=29,90
