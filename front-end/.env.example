# Origens do front multi-domínio (dev: adicione app.localhost no /etc/hosts -> 127.0.0.1)
VITE_APP_ORIGIN=http://app.localhost:5173
VITE_MARKETING_ORIGIN=http://localhost:5173

# Porta do Django em dev (proxy do Vite e runserver). 8001 evita conflito com Portainer (8000).
VITE_DEV_API_PORT=8001

# URL base da API Django (sem path /api). Em `npm run dev`, pode ficar vazio: o Vite
# faz proxy de /api -> http://127.0.0.1:${VITE_DEV_API_PORT} (veja vite.config.ts).
# Em build de produção, defina sempre (ex.: https://api.seudominio.com).
VITE_API_BASE_URL=http://127.0.0.1:8001

# Valor exibido no resumo do trial (alinhado ao DEFAULT_SUBSCRIPTION_VALUE do Django, ex.: 29.9)
VITE_TRIAL_SUBSCRIPTION_PRICE=29,90

# Preço exibido na landing (plano Pro)
VITE_PLAN_PRICE=59,90

# Google Tag Manager (landing / marketing — só carrega após consentimento).
# Eventos de funil (Lead, StartTrial, etc.) ficam no GTM via dataLayer.
VITE_GTM_ID=GTM-XXXXXXX

# Meta Pixel — PageView no browser (fbq init + track), após consentimento.
# Desative PageView na tag Meta "All Pages" do GTM para não duplicar.
VITE_META_PIXEL_ID=1009539298726554

# Preview WhatsApp/LinkedIn: og:image usa esta origem + /images/brand/og-marketchat-share.png
# (também injetado no index.html no build do Vite)

# App Meta (Facebook) — remove aviso "fb:app_id ausente" no Sharing Debugger
# Crie em https://developers.facebook.com/apps/ → Configurações → Básico → ID do aplicativo
# VITE_FB_APP_ID=1234567890123456

# Redes sociais no rodapé da landing (deixe vazio para ocultar o ícone)
# VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/seu_perfil
# VITE_SOCIAL_FACEBOOK=https://www.facebook.com/seu_perfil
# VITE_SOCIAL_LINKEDIN=https://www.linkedin.com/company/sua-empresa
# VITE_SOCIAL_YOUTUBE=https://www.youtube.com/@seu_canal
