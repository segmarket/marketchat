# Produção (carregado por `config.settings.production` — defina DJANGO_SETTINGS_MODULE no deploy).
# O `.env` na raiz é carregado antes (opcional); este arquivo sobrescreve.

DEBUG=False
ASAAS_WEBHOOK_VERIFY=True
ASAAS_WEBHOOK_TOKEN=defina_um_token_forte
ASAAS_WEBHOOK_NOTIFY_EMAIL=suporte@marketchat.com.br
ASAAS_API_URL=https://api.asaas.com/v3
# Começa com $ — não rode "source .env.production" no bash. O deploy usa env_file no Docker.
# Cadastro com cartão exige tokenização habilitada no Asaas (solicitar ao gerente em produção).
ASAAS_API_KEY=
FINANCIAL_PLATFORM_FEE_PERCENT=2
REDIS_URL=redis://default:SUA_SENHA@10.10.10.150:6379/7
# Formato: redis://[:senha@]host:6379/DB ou redis://usuario:senha@host:6379/DB (Redis ACL)
# Se o Redis exige senha e a URL estiver sem credencial → erro HELLO/AUTH no histórico de pagamentos.
PUBLIC_WEBHOOK_BASE_URL=https://app.marketchat.com.br

# Evolution GO (WhatsApp) — evoapicloud no Portainer (porta 9080)
EVOLUTION_API_BASE_URL=http://10.10.10.140:9080
# Mesmo valor de GLOBAL_API_KEY ou AUTHENTICATION_API_KEY do container evolution-go
EVOLUTION_GLOBAL_API_KEY=
EVOLUTION_WEBHOOK_EVENTS=MESSAGE,CONNECTION,QRCODE

# Portas publicadas no host (docker-compose.production.yml)
PRODUCTION_BACKEND_PORT=9001
PRODUCTION_FRONTEND_PORT=3000
DATABASE_URL=

ALLOWED_HOSTS=marketchat.com.br,app.marketchat.com.br

# CORS (origens exatas do front em produção, vírgula sem espaço)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://marketchat.com.br,https://app.marketchat.com.br

TRANSACTIONAL_FROM_EMAIL=MarketChat <suporte@marketchat.com.br>
MARKETING_PUBLIC_ORIGIN=https://marketchat.com.br

# Meta Sharing Debugger — meta property fb:app_id (ID do app em developers.facebook.com)
# VITE_FB_APP_ID=
FRONTEND_APP_ORIGIN=https://app.marketchat.com.br
FRONTEND_SIGNIN_URL=https://app.marketchat.com.br/signin
FRONTEND_PASSWORD_RESET_URL=https://app.marketchat.com.br/reset-password

# E-mail (opcional: config.email_backend.EmailBackend + EMAIL_SMTP_TLS_SERVERNAME se usar CNAME SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_SMTP_TLS_SERVERNAME=
